{
  "manifest_version": 3,
  "name": "GCH Check my work",
  "version": "0.7.0",
  "key": "",
  "description": "Check your saved GCH work from one floating button and receive a Word training review.",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "storage",
    "downloads",
    "alarms",
    "nativeMessaging",
    "webRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "https://crm.medtronic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://crm.medtronic.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html"
      ],
      "matches": [
        "https://crm.medtronic.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Check my work",
    "default_popup": "panel.html"
  },
  "options_page": "options.html"
}
